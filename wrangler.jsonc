{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves both websites: the shop (cityseller.in) and the admin (admin.cityseller.in).
  // Host-based routing and the admin lock-down live in src/middleware.ts.
  "name": "city-seller",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference used by OpenNext for caching; must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "city-seller" }
  ],
  "r2_buckets": [
    // Create once: pnpm wrangler r2 bucket create city-seller-opennext-cache
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "city-seller-opennext-cache" }
  ],
  "images": {
    // next/image optimisation via Cloudflare Images.
    "binding": "IMAGES"
  },
  // Only the real domains: no *.workers.dev or preview URLs (they would bypass Cloudflare Access).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "cityseller.in", "custom_domain": true },
    { "pattern": "www.cityseller.in", "custom_domain": true },
    { "pattern": "admin.cityseller.in", "custom_domain": true }
  ],
  // Non-secret runtime values. Secrets go in with `wrangler secret put` (see README).
  // NEXT_PUBLIC_* values are baked in at build time: set them in .env.production (or CI) before `pnpm deploy`.
  "vars": {
    "EMAIL_FROM": "City Seller <orders@cityseller.in>"
  },
  "observability": { "enabled": true }
}
