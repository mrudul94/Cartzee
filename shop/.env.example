# Shop website (cityseller.in). Copy to shop/.env.local — never commit real values.
# Locally, values missing here fall back to the root .env.local; each integration falls back to a mock when empty.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (order creation, payment webhook). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (shop only). Use rzp_test_… keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook https://cityseller.in/api/razorpay/webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Shared with the admin app: lets admin saves refresh the shop's cache. Long random string.
REVALIDATE_SECRET=

# Order emails and alerts
RESEND_API_KEY=
EMAIL_FROM="City Seller <orders@cityseller.in>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics and Search Console
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Simulated payments in a production build (staging only; ignored when Razorpay keys are set).
ALLOW_MOCK_PAYMENTS=false
