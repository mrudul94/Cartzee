# Admin website (admin.cityseller.in). Copy to admin/.env.local — never commit real values.
# The admin never needs Razorpay keys. Without Supabase, dev builds use a local "dev admin"; production refuses access.

# Public shop URL: used to refresh the shop cache and to show product images. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (same project as the shop)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (admin data, Team page). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Same value as the shop's REVALIDATE_SECRET.
REVALIDATE_SECRET=69c8dd3068261e32bb128323caa3700c74d2b237aac1c763cab2669a5c9aa480

# Admin sign-in codes and order status emails (required in production: admins cannot sign in without it)
RESEND_API_KEY=
EMAIL_FROM="City Seller <orders@cityseller.in>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Access (optional extra gate). When both are set, requests without a valid Access token are refused.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# TESTING ONLY: "off" pauses the emailed sign-in code (password-only admin sign-in). Remove before launch.
ADMIN_EMAIL_CODE=
