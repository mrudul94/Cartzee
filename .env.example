# Copy to .env.local (never commit real values). Every integration falls back to a local mock
# when its variables are empty, so the site runs with none of these set.

# Public site URL (canonical links, emails, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- Supabase
# Project Settings → API. All three are required to switch from seed data to the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS: never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Razorpay
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you choose when adding https://<domain>/api/razorpay/webhook
# (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Email (Resend)
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="City Seller <orders@cityseller.in>"

# ---------------------------------------------------------------- Admin alerts (Telegram)
# Create a bot with @BotFather; get the chat id by messaging the bot and calling getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- Flags
# Show /design-system in production (otherwise dev-only).
DESIGN_SYSTEM_PUBLIC=false
# Allow simulated payments in a production build (staging demos only; ignored when Razorpay keys are set).
ALLOW_MOCK_PAYMENTS=false
