{
  "name": "city-seller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:shop": "pnpm --filter @cityseller/shop dev",
    "dev:admin": "pnpm --filter @cityseller/admin dev",
    "build": "pnpm check:tokens && pnpm check:registry && pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "pnpm -r lint && pnpm check:tokens && pnpm check:registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "placeholders": "tsx scripts/gen-placeholders.ts",
    "registry:sync": "tsx scripts/registry.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:registry": "tsx scripts/registry.ts --check",
    "db:seed-sql": "tsx scripts/gen-seed-sql.ts",
    "deploy:shop": "pnpm lint && pnpm test && pnpm --filter @cityseller/shop cf:deploy",
    "deploy:admin": "pnpm lint && pnpm test && pnpm --filter @cityseller/admin cf:deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.15",
    "lucide-react": "1.72.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "1.20.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "wrangler": "4.157.0"
  },
  "packageManager": "pnpm@12.4.2"
}
