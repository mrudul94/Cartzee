{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./shared/src/*", "./admin/src/*", "./shop/src/*"],
      "@shop/*": ["./shop/src/*"],
      "@admin/*": ["./admin/src/*"]
    }
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "shop", "admin"]
}
